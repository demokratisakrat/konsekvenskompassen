{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "konsekvenskompassen",
  "main": "./workers/app.ts",
  "routes": [
    { "pattern": "konsekvenskompassen.se", "custom_domain": true },
    { "pattern": "www.konsekvenskompassen.se", "custom_domain": true },
    // valsnack.se är kanonisk; www och den gamla domänen 301:ar dit i workers/app.ts.
    { "pattern": "valsnack.se", "custom_domain": true },
    { "pattern": "www.valsnack.se", "custom_domain": true },
  ],
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // "anthropic", "claude-vertex" eller "gemini" — se app/lib/providers/
    "CHAT_PROVIDER": "anthropic",
    // Bytt 2026-09-24 från claude-sonnet-5 (utan effort) efter mätningen i docs/plan.md.
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "ANTHROPIC_EFFORT": "low",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "analytics_engine_datasets": [
    { "binding": "DEMOKRATISAKRAT_ANALYTICS", "dataset": "demokratisakrat_analytics" },
  ],
}
